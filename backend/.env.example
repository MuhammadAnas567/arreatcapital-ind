LISTINGS_API_BASE_URL=https://youtupia.net/SingleListingApp/api
LISTINGS_CLIENT_ID=
LISTINGS_CLIENT_SECRET=

# Local dev
CORS_ORIGIN=http://localhost:5173
PORT=3001

# Vercel (Project → Settings → Environment Variables)
# Required:
#   LISTINGS_API_BASE_URL
#   LISTINGS_CLIENT_ID
#   LISTINGS_CLIENT_SECRET
# Optional:
#   CORS_ORIGIN — auto-detected from VERCEL_URL if omitted
# Do NOT set VITE_API_BASE_URL on Vercel (leave empty for same-domain /api calls)
